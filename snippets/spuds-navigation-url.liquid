{%- doc -%}
  Resolves the Shop destination from the collection linked in the footer menu.
  @param {link} [link] - Navigation item. Defaults to the all-products destination.
{%- enddoc -%}
{%- liquid
  assign link_label = link.title | handleize
  if link == blank or link_label == 'shop'
    assign shop_link = linklists.footer.links | where: 'type', 'collection_link' | first
    echo shop_link.url | default: routes.all_products_collection_url
  else
    echo link.url
  endif
-%}
