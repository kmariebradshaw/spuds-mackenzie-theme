{% doc %}
  Renders the storefront navigation label for a menu item.
  @param {link} link - Navigation link to label.
  @param {section} [section] - Header section with an optional Contact URL.
{% enddoc %}
{%- liquid
  if link.url contains '/pages/contact' or link.url == section.settings.spuds_contact_link
    echo 'spuds_navigation.contact' | t
  else
    echo link.title | escape
  endif
-%}
