{% doc %}
  Loads the commemorative gift cart integration and identifies carts that need an initial update.
{% enddoc %}
{% liquid
  assign gift_id = 68489683534052
  assign gift_count = cart | item_count_for_variant: gift_id
  assign target = 0
  if cart.currency.iso_code == 'USD' and cart.total_price >= 7500
    assign target = 1
  endif
%}
<script
  id="spuds-gift-config"
  src="{{ 'spuds-cart-gift.js' | asset_url }}"
  type="module"
  data-variant="{{ gift_id }}"
  data-threshold="7500"
  {% if target != gift_count %}data-needs-sync{% endif %}
></script>
