{% doc %}
  Displays the gift that Shopify Flow adds to qualifying orders after checkout.
{% enddoc %}
<div class="spuds-cart-gift">
  {% assign can = images['spuds-welcome-commemorative-can.png'] %}
  {% if can != blank %}
    {{ can | image_url: height: 128 | image_tag: class: 'spuds-cart-gift__image', alt: '', loading: 'lazy' }}
  {% endif %}
  <div>
    <strong>{{ 'spuds_gift.title' | t }}</strong>
    <span>{{ 'spuds_gift.detail' | t }}</span>
    <small>{{ 'spuds_gift.qualification' | t }}</small>
  </div>
</div>

{% stylesheet %}
  .spuds-cart-gift {
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 1vw, 1rem);
    padding: clamp(0.65rem, 1vw, 1rem);
    background: #faf0e4;
    color: #071b3d;
    border-inline-start: 0.25rem solid #f63264;
  }
  .spuds-cart-gift__image { height: clamp(2.8rem, 4vw, 4rem); width: auto; }
  .spuds-cart-gift strong, .spuds-cart-gift span, .spuds-cart-gift small { display: block; }
{% endstylesheet %}
