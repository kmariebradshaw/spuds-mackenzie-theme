{% assign spuds_product_stylesheet = 'spuds-product.css' | asset_url | append: '&spuds=20260821-2' %}
{{ spuds_product_stylesheet | stylesheet_tag }}
{{ 'spuds-sticky-cart.css' | asset_url | stylesheet_tag }}
<script src="{{ 'spuds-sticky-cart.js' | asset_url }}" type="module"></script>
<script
  src="{{ 'spuds-product.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign gallery_media = product.media | where: 'preview_image'
  assign variant_gallery = product.metafields.custom.variant_gallery.value
  assign current_variant_key = current_variant.id | append: ''
  assign current_gallery_ids = variant_gallery[current_variant_key]
  assign variant_media_ids = product.variants | map: 'featured_media' | map: 'id'
  assign visible_gallery_media = '' | split: ','
  for media in gallery_media
    assign media_key = media.id | append: ''
    if current_gallery_ids != blank
      unless current_gallery_ids contains media_key
        continue
      endunless
    elsif variant_media_ids contains media.id
      if media.id != current_variant.featured_media.id
        continue
      endif
    endif
    assign matched_media = gallery_media | where: 'id', media.id
    assign visible_gallery_media = visible_gallery_media | concat: matched_media
  endfor
  assign visible_media_ids = visible_gallery_media | map: 'id'
  assign title_downcase = product.title | downcase
  assign use_delivered_assets = false
  if section.settings.use_delivered_chicken_assets and title_downcase contains 'chicken' and title_downcase contains 'bundle'
    assign use_delivered_assets = true
  endif

  assign breadcrumb_collection = collection
  if breadcrumb_collection == blank
    assign breadcrumb_collection = product.collections.first
  endif

  assign eyebrow = product.metafields.custom.pdp_eyebrow.value
  if eyebrow == blank and breadcrumb_collection != blank
    assign eyebrow = breadcrumb_collection.title
  endif
  if eyebrow == blank
    assign eyebrow = section.settings.eyebrow
  endif

  assign tagline = product.metafields.custom.product_tagline.value

  assign use_variant_content = product.metafields.custom.variant_content_enabled.value
  assign product_type = product.type | downcase
  assign directions_label = 'spuds_product.feeding_directions' | t
  assign ingredient_details_label = 'spuds_product.ingredients_feeding' | t
  if product_type == 'salon'
    assign directions_label = 'spuds_product.how_to_use' | t
    assign ingredient_details_label = 'spuds_product.ingredients_use' | t
  endif

  capture description_content
    if use_variant_content
      if current_variant.metafields.custom.description.value != blank
        echo current_variant.metafields.custom.description | metafield_tag
      endif
    elsif section.settings.description_override != blank
      echo section.settings.description_override
    elsif product.description != blank
      echo product.description
    else
      echo section.settings.description_fallback
    endif
  endcapture
  assign description_plain = description_content | replace: '</p>', '</p> ' | strip_html | strip
  assign description_words = description_plain | split: ' '

  assign ingredients_metafield = product.metafields.custom.ingredients
  assign feeding_directions_metafield = product.metafields.custom.feeding_directions
  if use_variant_content
    assign ingredients_metafield = current_variant.metafields.custom.ingredients
    assign feeding_directions_metafield = current_variant.metafields.custom.feeding_directions
  endif

  assign has_ingredient_details = false
  if ingredients_metafield.value != blank or feeding_directions_metafield.value != blank
    assign has_ingredient_details = true
  endif

  assign form_id = 'SpudsProductForm-' | append: section.id
%}

<section
  class="spuds-pdp"
  data-spuds-product
  data-section-id="{{ section.id }}"
  data-variant-content="{{ use_variant_content }}"
  data-adding-label="{{ 'products.product.adding_to_cart' | t | escape }}"
  data-quantity-label="{{ 'products.product.quantity' | t | escape }}"
  data-add-label="{{ 'actions.add_to_cart' | t | escape }}"
  data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}"
  data-cart-error="{{ 'products.product.add_to_cart_error' | t | escape }}"
  data-delivered-gallery="{{ use_delivered_assets }}"
  style="--spuds-pdp-accent: {{ section.settings.accent_color }};"
  {{ section.shopify_attributes }}
>
  <div class="spuds-pdp__inner">
    <nav class="spuds-pdp__breadcrumbs" aria-label="Breadcrumb">
      <a href="{% render 'spuds-navigation-url' %}">All Spuds</a>
      <span aria-hidden="true">&gt;</span>
      {% if breadcrumb_collection != blank %}
        <a href="{{ breadcrumb_collection.url }}">{{ breadcrumb_collection.title }}</a>
        <span aria-hidden="true">&gt;</span>
      {% elsif eyebrow != blank %}
        <span>{{ eyebrow }}</span>
        <span aria-hidden="true">&gt;</span>
      {% endif %}
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="spuds-pdp__grid">
      <div class="spuds-pdp__gallery">
        <div class="spuds-pdp__main-media">
          {% if use_delivered_assets %}
            <img
              src="{{ 'Chicken-Bundle-PI.webp' | asset_url }}"
              alt="{{ product.title | escape }}"
              width="1392"
              height="1052"
              loading="eager"
              fetchpriority="high"
              data-spuds-main-image
            >
          {% else %}
            {% liquid
              assign featured_media = current_variant.featured_media | default: visible_gallery_media.first | default: product.featured_media
              if product.selected_variant == blank and visible_media_ids contains product.featured_media.id
                case product.handle
                  when 'rawhide-dental-chews', 'monster-bully-sticks'
                    assign featured_media = product.featured_media
                endcase
              endif
            %}
            {% if featured_media.preview_image != blank %}
              <img
                src="{% render 'spuds-product-photo', photo: featured_media.preview_image, width: 1600 %}"
                alt="{{ featured_media.alt | default: product.title | escape }}"
                width="{{ featured_media.preview_image.width }}"
                height="{{ featured_media.preview_image.height }}"
                loading="eager"
                fetchpriority="high"
                data-spuds-main-image
              >
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'spuds-pdp__placeholder' }}
            {% endif %}
          {% endif %}
        </div>

        {% if use_delivered_assets or gallery_media.size > 1 %}
        <div class="spuds-pdp__thumb-rail" data-spuds-gallery-rail{% unless use_delivered_assets or visible_gallery_media.size > 1 %} hidden{% endunless %}>
          <button
            class="spuds-pdp__gallery-arrow spuds-pdp__gallery-arrow--previous"
            type="button"
            aria-label="Previous product image"
            data-spuds-gallery-previous
          >
            {{- 'icon-chevron-left.svg' | inline_asset_content -}}
          </button>

          <div class="spuds-pdp__thumbnails" data-spuds-thumbnails>
            {% if use_delivered_assets %}
              {% assign delivered_thumbs = 'Chicken-Bundle2-PI.png|ChickenChips-PI.png|Recommended-PI.png' | split: '|' %}
              {% for delivered_thumb in delivered_thumbs %}
                <button
                  class="spuds-pdp__thumbnail{% if forloop.first %} is-active{% endif %}"
                  type="button"
                  aria-label="View {{ product.title | escape }} image {{ forloop.index }}"
                  aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                  data-spuds-gallery-thumb
                  data-image="{{ delivered_thumb | asset_url }}"
                  data-alt="{{ product.title | escape }} image {{ forloop.index }}"
                >
                  <img
                    src="{{ delivered_thumb | asset_url }}"
                    alt=""
                    width="404"
                    height="304"
                    loading="lazy"
                  >
                </button>
              {% endfor %}
            {% else %}
              {% for media in gallery_media %}
                {% if media.preview_image != blank %}
                  <button
                    class="spuds-pdp__thumbnail{% if media.id == featured_media.id %} is-active{% endif %}"
                    type="button"
                    aria-label="View {{ media.alt | default: product.title | escape }}"
                    aria-pressed="{% if media.id == featured_media.id %}true{% else %}false{% endif %}"
                    data-spuds-gallery-thumb
                    data-media-id="{{ media.id }}"
                    data-variant-image="{% if variant_media_ids contains media.id %}true{% else %}false{% endif %}"
                    {% unless visible_media_ids contains media.id %}hidden{% endunless %}
                    data-image="{% render 'spuds-product-photo', photo: media.preview_image, width: 1600 %}"
                    data-alt="{{ media.alt | default: product.title | escape }}"
                  >
                    <img
                      src="{% render 'spuds-product-photo', photo: media.preview_image, width: 360 %}"
                      alt=""
                      width="{{ media.preview_image.width }}"
                      height="{{ media.preview_image.height }}"
                      loading="lazy"
                    >
                  </button>
                {% endif %}
              {% endfor %}
            {% endif %}
          </div>

          <button
            class="spuds-pdp__gallery-arrow spuds-pdp__gallery-arrow--next"
            type="button"
            aria-label="Next product image"
            data-spuds-gallery-next
          >
            {{- 'icon-chevron-right.svg' | inline_asset_content -}}
          </button>
        </div>
        {% endif %}
      </div>

      <div class="spuds-pdp__details">
        {% if eyebrow != blank %}
          <p class="spuds-pdp__eyebrow">{{ eyebrow }}</p>
        {% endif %}

        <h1 class="spuds-pdp__title">{{ product.title }}</h1>

        {% if tagline != blank %}
          <p class="spuds-pdp__tagline" style="--tagline-length: {{ tagline | size }}">{{ tagline | escape }}</p>
        {% endif %}

        <product-form-component
          id="{{ form_id }}-Component"
          class="spuds-pdp__product-form"
          data-section-id="{{ section.id }}"
          data-product-id="{{ product.id }}"
          data-product-url="{{ product.url }}"
          data-quantity-default="{{ current_variant.quantity_rule.min | default: 1 }}"
          on:submit="/handleSubmit"
        >
          <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>

          {% form 'product', product, id: form_id, data-type: 'add-to-cart-form' %}
            <input
              type="hidden"
              name="id"
              value="{{ current_variant.id }}"
              ref="variantId"
              data-spuds-variant-id
            >
            {% unless product.has_only_default_variant %}
              <div class="spuds-pdp__variant-row" data-spuds-option-picker>
                {% for option in product.options_with_values %}
                  <fieldset class="spuds-pdp__option-group" data-option-index="{{ forloop.index0 }}">
                    <legend>{{ option.name | escape }}</legend>
                    <div class="spuds-pdp__option-buttons">
                      {% for value in option.values %}
                        <button
                          type="button"
                          class="spuds-pdp__option-button"
                          value="{{ value.name | escape }}"
                          aria-pressed="{% if value.selected %}true{% else %}false{% endif %}"
                        >{{ value.name | escape }}</button>
                      {% endfor %}
                    </div>
                  </fieldset>
                {% endfor %}
                <noscript>
                  <style>.spuds-pdp__option-group { display: none; }</style>
                  {% for variant in product.variants %}
                    <a href="{{ variant.url | escape }}">{{ variant.title | escape }}</a>
                  {% endfor %}
                </noscript>
                <select data-spuds-variant-select hidden>
                  {% for variant in product.variants %}
                    {% assign gallery_variant_key = variant.id | append: '' %}
                    <option
                      value="{{ variant.id }}"
                      data-options="{{ variant.options | json | escape }}"
                      data-price="{{ variant.price | money | escape }}"
                      data-available="{{ variant.available }}"
                      data-image="{% if variant.featured_media.preview_image != blank %}{% render 'spuds-product-photo', photo: variant.featured_media.preview_image, width: 1600 %}{% endif %}"
                      data-media-id="{{ variant.featured_media.id }}"
                      data-gallery-media-ids="{{ variant_gallery[gallery_variant_key] | json | escape }}"
                      {% if variant.id == current_variant.id %}selected{% endif %}
                    >
                      {{ variant.title }}
                    </option>
                  {% endfor %}
                </select>
              </div>
            {% endunless %}

            <div data-spuds-subscription-widget>
              {% for block in section.blocks %}
                {% render block %}
              {% else %}
                <div class="subscriptions_app_embed_block"></div>
              {% endfor %}
            </div>

            <fieldset class="spuds-pdp__purchase-options" data-spuds-purchase-options>
              {% render 'spuds-purchase-options', variant: current_variant, one_time_label: section.settings.one_time_label, subscription_label: section.settings.subscribe_label, selected_plan_id: product.selected_selling_plan.id %}
            </fieldset>
            {% if product.selling_plan_groups.size > 0 and product.variants.size > 1 %}
              {% for variant in product.variants %}
                <template data-spuds-plan-options="{{ variant.id }}">
                  {% render 'spuds-purchase-options', variant: variant, one_time_label: section.settings.one_time_label, subscription_label: section.settings.subscribe_label %}
                </template>
              {% endfor %}
            {% endif %}

            <div class="spuds-pdp__actions">
              <div class="spuds-pdp__quantity" data-spuds-quantity>
                <button type="button" aria-label="Decrease quantity" data-spuds-quantity-minus>&minus;</button>
                <input
                  type="number"
                  name="quantity"
                  value="{{ current_variant.quantity_rule.min | default: 1 }}"
                  min="{{ current_variant.quantity_rule.min | default: 1 }}"
                  step="{{ current_variant.quantity_rule.increment | default: 1 }}"
                  {% if current_variant.quantity_rule.max != blank %}max="{{ current_variant.quantity_rule.max }}"{% endif %}
                  aria-label="Quantity"
                  data-spuds-quantity-input
                >
                <button type="button" aria-label="Increase quantity" data-spuds-quantity-plus>&plus;</button>
              </div>

              <add-to-cart-component
                ref="addToCartButtonContainer"
                data-product-variant-media="{% if current_variant.featured_media.preview_image != blank %}{% render 'spuds-product-photo', photo: current_variant.featured_media.preview_image, width: 100 %}{% elsif product.featured_media.preview_image != blank %}{% render 'spuds-product-photo', photo: product.featured_media.preview_image, width: 100 %}{% endif %}"
                data-add-to-cart-animation="{{ settings.add_to_cart_animation }}"
              >
                <button
                  type="submit"
                  name="add"
                  class="spuds-pdp__add-to-cart"
                  ref="addToCartButton"
                  on:click="/handleClick"
                  {% unless current_variant.available %}disabled{% endunless %}
                  data-spuds-add-to-cart
                >
                  <span data-spuds-add-label>
                    {% if current_variant.available %}{{ 'actions.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}
                  </span>
                  <span class="spuds-pdp__add-arrow" aria-hidden="true">
                    {{- 'spuds-cta-arrow.svg' | inline_asset_content -}}
                  </span>
                  <span class="add-to-cart__added" aria-hidden="true">
                    <span class="svg-wrapper add-to-cart__added-icon">
                      {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
                    </span>
                  </span>
                </button>
              </add-to-cart-component>
            </div>

            <p class="spuds-pdp__error hidden" ref="addToCartTextError" role="alert"></p>
          {% endform %}
        </product-form-component>

        <div data-spuds-content data-variant-id="{{ current_variant.id }}" aria-live="polite" aria-busy="false">
          {% if description_plain != blank %}
            <div class="spuds-pdp__description" data-spuds-description>
              <p>
                <strong>{{ 'spuds_product.description' | t }}</strong>
                <span data-spuds-description-short>
                  {% if description_words.size > 24 %}
                    {{ description_plain | truncatewords: 24, '' }}
                  {% else %}
                    {{ description_plain }}
                  {% endif %}
                </span>
                {% if description_words.size > 24 %}
                  <button
                    type="button"
                    data-spuds-read-more
                    data-label-more="{{ 'spuds_product.read_more' | t | escape }}"
                    data-label-less="{{ 'spuds_product.read_less' | t | escape }}"
                    aria-expanded="false"
                  >{{ 'spuds_product.read_more' | t }}</button>
                {% endif %}
              </p>
              {% if description_words.size > 24 %}
                <div class="spuds-pdp__description-full" hidden data-spuds-description-full>
                  {{ description_content }}
                </div>
              {% endif %}
            </div>
          {% endif %}

          {% if has_ingredient_details %}
            <details class="spuds-pdp__ingredients-accordion">
              <summary>
                <span>{{ ingredient_details_label }}</span>
                <span class="spuds-pdp__ingredients-toggle" aria-hidden="true">+</span>
              </summary>
              <div class="spuds-pdp__ingredients-content">
                {% if ingredients_metafield.value != blank %}
                  <div class="spuds-pdp__ingredients-item">
                    <h3>{{ 'spuds_product.ingredients' | t }}</h3>
                    {{ ingredients_metafield | metafield_tag }}
                  </div>
                {% endif %}

                {% if feeding_directions_metafield.value != blank %}
                  <div class="spuds-pdp__ingredients-item">
                    <h3>{{ directions_label }}</h3>
                    {{ feeding_directions_metafield | metafield_tag }}
                  </div>
                {% endif %}
              </div>
            </details>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
  {% render 'spuds-sticky-cart', product: product, current_variant: current_variant %}
</section>

{% schema %}
{
  "name": "Spuds product page",
  "tag": "section",
  "class": "section-spuds-product-page",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [{ "type": "@app" }],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Fallback category label",
      "default": "SPUDS SNACKS"
    },
    {
      "type": "checkbox",
      "id": "use_delivered_chicken_assets",
      "label": "Use supplied artwork for Chicken Bundle",
      "default": true
    },
    {
      "type": "richtext",
      "id": "description_override",
      "label": "Description override"
    },
    {
      "type": "textarea",
      "id": "description_fallback",
      "label": "Fallback description",
      "default": "Crunchy Chicken Chips made for backyard hangs, game days, tailgates, and treat-time celebrations everywhere."
    },
    {
      "type": "paragraph",
      "content": "Content uses product metafields custom.ingredients and custom.feeding_directions. Enable custom.variant_content_enabled to use the selected variant's custom.description, custom.ingredients and custom.feeding_directions rich text fields instead. Empty fields are hidden. Salon products use How to Use labels."
    },
    {
      "type": "text",
      "id": "one_time_label",
      "label": "One-time purchase label",
      "default": "One-time purchase"
    },
    {
      "type": "text",
      "id": "subscribe_label",
      "label": "Subscription label",
      "default": "Subscribe & save"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#ff2f69"
    }
  ],
  "presets": [
    {
      "name": "Spuds product page"
    }
  ]
}
{% endschema %}
