{%- liquid
  assign cfg = section.settings
  assign eligible_pages = 'index,collection,list-collections,product,page,blog,article,search' | split: ','
  assign signup_id = 'SpudsWelcomeSignup-' | append: section.id
  assign artwork = cfg.artwork | default: images['SpudsATF-Mobile.png']
  assign can = cfg.can_image | default: images['spuds-welcome-commemorative-can.png']
  assign brand_logo = cfg.popup_logo | default: images['spuds-mackenzie-logo-cream-pink.png']
  assign known_customer = false
  if customer.accepts_marketing or customer.orders_count > 0
    assign known_customer = true
  endif
-%}
{% if cfg.enabled and eligible_pages contains request.page_type %}
  {{ 'spuds-welcome.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'spuds-welcome.js' | asset_url }}" type="module"></script>
  <spuds-welcome-popup
    data-delay="{{ cfg.delay | times: 1000 }}"
    {% if cfg.snooze_on_dismiss %}data-snooze-on-dismiss{% endif %}
    data-form-id="{{ signup_id | escape }}"
    {% if known_customer %}data-known-customer{% endif %}
    {% if request.design_mode %}data-editor{% endif %}
  >
    <dialog class="spuds-welcome" aria-labelledby="SpudsWelcomeTitle-{{ section.id }}">
      <div class="spuds-welcome__panel">
        <div class="spuds-welcome__art" aria-hidden="true">
          {% if artwork != blank %}
            {{ artwork | image_url: width: 1600 | image_tag: class: 'spuds-welcome__photo', widths: '400,600,800,1100,1600', sizes: '(max-width: 749px) 89vw, 52vw', alt: '', loading: 'lazy' }}
          {% endif %}
          {% if can != blank %}
            <svg class="spuds-welcome__gift-arrow" aria-hidden="true" viewBox="0 0 160 56" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 7c16 49 94 61 146 5m-16 4 20-9-4 20"/>
            </svg>
            {{ can | image_url: width: can.width | image_tag: class: 'spuds-welcome__can', widths: '100,160,222,400', sizes: '(max-width: 749px) 16vw, 9vw', alt: '', loading: 'lazy' }}
          {% endif %}
        </div>
        <div class="spuds-welcome__content">
          {% if brand_logo != blank %}
            {{ brand_logo | image_url: width: 640 | image_tag: class: 'spuds-welcome__logo', widths: '160,320,480,640', sizes: '(max-width: 749px) 25vw, 12vw', alt: shop.name, loading: 'lazy' }}
          {% endif %}
          <h2 id="SpudsWelcomeTitle-{{ section.id }}" tabindex="-1">{{ cfg.heading | escape }}</h2>
          {% form 'customer', id: signup_id, class: 'spuds-welcome__form' %}
            <input name="contact[tags]" type="hidden" value="newsletter,spuds-welcome-popup">
            {% if form.posted_successfully? %}
              <div class="spuds-welcome__result" data-signup-result="success" role="status">
                <p>Thanks for signing up! Use <strong>{{ cfg.code | escape }}</strong> at checkout with the email you entered.</p>
                <a class="spuds-welcome__button" href="{{ routes.root_url }}discount/{{ cfg.code | url_encode }}?redirect={{ routes.all_products_collection_url | url_encode }}">Apply my 20% off</a>
              </div>
            {% else %}
              <div class="spuds-welcome__offer">{{ cfg.offer }}</div>
              <label class="visually-hidden" for="{{ signup_id }}-email">Email address</label>
              <input id="{{ signup_id }}-email" class="spuds-welcome__input" type="email" name="contact[email]"
                placeholder="Email address" autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" required
                value="{{ form.email | escape }}"
                aria-describedby="{{ signup_id }}-consent{% if form.errors %} {{ signup_id }}-error{% endif %}"
                {% if form.errors %}aria-invalid="true"{% endif %}>
              {% if form.errors %}
                <div id="{{ signup_id }}-error" class="spuds-welcome__error" data-signup-result="error" role="alert">{{ form.errors | default_errors }}</div>
              {% endif %}
              <button type="submit" class="spuds-welcome__button">{{ cfg.cta | escape }}</button>
              <small id="{{ signup_id }}-consent">By signing up, you agree to receive marketing emails from Spuds.</small>
            {% endif %}
          {% endform %}
        </div>
      </div>
      <button type="button" class="spuds-welcome__close" aria-label="Close welcome offer">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m5 5 14 14M19 5 5 19"/></svg>
      </button>
    </dialog>
  </spuds-welcome-popup>
{% endif %}

{% schema %}
{
  "name": "Spuds welcome popup",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show welcome popup", "default": true },
    { "type": "range", "id": "delay", "label": "Delay before opening", "min": 0, "max": 20, "step": 1, "unit": "s", "default": 5 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 20% Off" },
    { "type": "richtext", "id": "offer", "label": "Offer", "default": "<p>Enter your email to get 20% off your first order and a <strong>Free Commemorative 2.3oz. Spuds Can</strong> with orders over $75.</p>" },
    { "type": "text", "id": "cta", "label": "Signup button", "default": "GET MY 20% OFF" },
    { "type": "text", "id": "code", "label": "Active Shopify discount code", "default": "WELCOME20" },
    { "type": "image_picker", "id": "artwork", "label": "Poolside photo", "info": "Defaults to the square mobile homepage photo." },
    { "type": "image_picker", "id": "can_image", "label": "Commemorative can" },
    { "type": "image_picker", "id": "popup_logo", "label": "Popup logo" },
    { "type": "header", "content": "Pre-launch flags" },
    { "type": "checkbox", "id": "snooze_on_dismiss", "label": "Hide for 7 days after dismissal", "info": "Turn off to preview the popup again after each page reload.", "default": true }
  ]
}
{% endschema %}
