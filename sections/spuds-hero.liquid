{{ 'spuds-homepage.css' | asset_url | stylesheet_tag }}
{% assign hero_image = section.settings.hero_image %}
{% assign hero_headline_graphic = section.settings.hero_headline_graphic %}
{% assign hero_polaroid_cluster = section.settings.hero_polaroid_cluster %}
{% assign hero_button_accent_left = section.settings.hero_button_accent_left %}
{% assign hero_button_accent_right = section.settings.hero_button_accent_right %}
{% assign category_accent_left = section.settings.category_accent_left %}
{% assign category_accent_right = section.settings.category_accent_right %}

<section class="spuds-home" id="SpudsHero-{{ section.id }}">
  <div class="spuds-shell">
    <div class="spuds-hero">
      <div class="spuds-hero__image">
        {% if hero_image != blank %}
          {{ hero_image | image_url: width: 2400 | image_tag: widths: '750,1100,1500,2000,2400', sizes: '(max-width: 990px) 100vw, 76vw', loading: 'eager', fetchpriority: 'high' }}
        {% else %}
          <img src="{{ 'spuds-hero.png' | asset_url }}" width="1537" height="1023" alt="Spuds MacKenzie relaxing at a pool party" loading="eager" fetchpriority="high">
        {% endif %}
      </div>

      <div class="spuds-hero__copy">
        <p class="spuds-hero__eyebrow">{{ section.settings.hero_eyebrow }}</p>
        <h1 class="spuds-hero__headline">
          {% if hero_headline_graphic != blank %}
            {{ hero_headline_graphic | image_url: width: 1400 | image_tag: widths: '500,750,1000,1400', sizes: '31vw', class: 'spuds-hero__headline-image', loading: 'eager', alt: '' }}
          {% else %}
            <img class="spuds-hero__headline-image" src="{{ 'HP-ATF-TextVectorized.webp' | asset_url }}" width="1400" height="1297" alt="" loading="eager">
          {% endif %}
          <span class="visually-hidden">{{ section.settings.hero_kicker }} {{ section.settings.hero_title }} {{ section.settings.hero_subtitle }}</span>
        </h1>
        <a class="spuds-button" href="{{ section.settings.hero_link }}">
          {{ section.settings.hero_button }}
          {% render 'spuds-shape', shape: 'arrow', color: '#ff2e6c' %}
        </a>
      </div>

      <div class="spuds-hero__polaroids" aria-hidden="true">
        {% if hero_polaroid_cluster != blank %}
          {{ hero_polaroid_cluster | image_url: width: 1800 | image_tag: widths: '500,750,1000,1400,1800', sizes: '19vw', class: 'spuds-hero__polaroid-cluster', loading: 'eager', alt: '' }}
        {% else %}
          <img class="spuds-hero__polaroid-cluster" src="{{ 'HP-ATF-Polaroids-Chips.webp' | asset_url }}" width="1009" height="1731" alt="" loading="eager">
        {% endif %}
        {% render 'spuds-shape', shape: 'paw', color: '#ff2e6c', class: 'spuds-hero__polaroid-paw' %}
      </div>
      {% if hero_button_accent_left != blank %}
        {{ hero_button_accent_left | image_url: width: 300 | image_tag: widths: '100,200,300', sizes: '4vw', class: 'spuds-float-shape spuds-hero__button-accent spuds-hero__button-accent--left', loading: 'eager', alt: '' }}
      {% else %}
        {% render 'spuds-shape', shape: 'graphic-3', class: 'spuds-float-shape spuds-hero__button-accent spuds-hero__button-accent--left' %}
      {% endif %}
      {% if hero_button_accent_right != blank %}
        {{ hero_button_accent_right | image_url: width: 300 | image_tag: widths: '100,200,300', sizes: '4vw', class: 'spuds-float-shape spuds-hero__button-accent spuds-hero__button-accent--right', loading: 'eager', alt: '' }}
      {% else %}
        {% render 'spuds-shape', shape: 'graphic-3', class: 'spuds-float-shape spuds-hero__button-accent spuds-hero__button-accent--right' %}
      {% endif %}
      {% render 'spuds-shape', shape: 'triangle', color: '#45c4cc', class: 'spuds-float-shape spuds-float-shape--one' %}
      {% render 'spuds-shape', shape: 'zigzag', color: '#ffbd20', class: 'spuds-float-shape spuds-float-shape--two' %}
      {% render 'spuds-shape', shape: 'zigzag', color: '#ffbd20', class: 'spuds-float-shape spuds-float-shape--three' %}
      {% render 'spuds-shape', shape: 'triangle', color: '#45c4cc', class: 'spuds-float-shape spuds-float-shape--four' %}
    </div>

    <div class="spuds-categories" aria-label="Shop product categories">
      {% if category_accent_left != blank %}
        {{ category_accent_left | image_url: width: 700 | image_tag: widths: '250,400,550,700', sizes: '11vw', class: 'spuds-float-shape spuds-categories__accent spuds-categories__accent--left', loading: 'lazy', alt: '' }}
      {% else %}
        {% render 'spuds-shape', shape: 'graphic-2', class: 'spuds-float-shape spuds-categories__accent spuds-categories__accent--left' %}
      {% endif %}
      {% if category_accent_right != blank %}
        {{ category_accent_right | image_url: width: 700 | image_tag: widths: '250,400,550,700', sizes: '10vw', class: 'spuds-float-shape spuds-categories__accent spuds-categories__accent--right', loading: 'lazy', alt: '' }}
      {% else %}
        {% render 'spuds-shape', shape: 'graphic-1', class: 'spuds-float-shape spuds-categories__accent spuds-categories__accent--right' %}
      {% endif %}
      {% for block in section.blocks %}
        <article class="spuds-category" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 800 | image_tag: class: 'spuds-category__image', loading: 'lazy' }}
          {% else %}
            <img class="spuds-category__image" src="{{ 'spuds-products.png' | asset_url }}" alt="" loading="lazy">
          {% endif %}
          <div>
            <h2><strong>Spuds</strong>{{ block.settings.title }}</h2>
            <p>{{ block.settings.products | newline_to_br }}</p>
            <a class="spuds-text-link" href="{{ block.settings.link }}">{{ block.settings.link_label }} →</a>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Spuds hero",
  "tag":"section",
  "class":"section-spuds-hero",
  "settings":[
    {"type":"image_picker","id":"hero_image","label":"Hero image"},
    {"type":"image_picker","id":"hero_headline_graphic","label":"Hero headline graphic"},
    {"type":"image_picker","id":"hero_polaroid_cluster","label":"Polaroids and treats graphic"},
    {"type":"image_picker","id":"hero_button_accent_left","label":"Button left triangle graphic"},
    {"type":"image_picker","id":"hero_button_accent_right","label":"Button right triangle graphic"},
    {"type":"image_picker","id":"category_accent_left","label":"Category left accent graphic"},
    {"type":"image_picker","id":"category_accent_right","label":"Category right accent graphic"},
    {"type":"text","id":"hero_eyebrow","label":"Eyebrow","default":"Pet treats & wellness inspired by a legend."},
    {"type":"text","id":"hero_kicker","label":"Brush label","default":"The Original"},
    {"type":"text","id":"hero_title","label":"Heading","default":"Party Animal"},
    {"type":"text","id":"hero_subtitle","label":"Accent heading","default":"Is Back!"},
    {"type":"text","id":"hero_button","label":"Button label","default":"Shop now"},
    {"type":"url","id":"hero_link","label":"Button link"}
  ],
  "blocks":[
    {
      "type":"category",
      "name":"Product category",
      "limit":3,
      "settings":[
        {"type":"image_picker","id":"image","label":"Product image"},
        {"type":"text","id":"title","label":"Title","default":"Snacks"},
        {"type":"textarea","id":"products","label":"Product list","default":"Treat chips\nTreat chews\nChew sticks"},
        {"type":"text","id":"link_label","label":"Link label","default":"Shop now"},
        {"type":"url","id":"link","label":"Link"}
      ]
    }
  ],
  "presets":[
    {
      "name":"Spuds hero",
      "blocks":[
        {"type":"category","settings":{"title":"Snacks","products":"Treat chips\nTreat chews\nChew sticks"}},
        {"type":"category","settings":{"title":"Health","products":"Dental chews\nJoint care chews\nVitamin chews"}},
        {"type":"category","settings":{"title":"Salon","products":"Nose & paw balm\nEar wipes\nShampoo"}}
      ]
    }
  ]
}
{% endschema %}
