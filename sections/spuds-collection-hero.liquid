{{ 'spuds-collection.css' | asset_url | stylesheet_tag }}

{% liquid
  assign shop_link = linklists.footer.links | where: 'type', 'collection_link' | first
  assign hero_image = collection.image
  if hero_image == blank
    assign hero_image = collection.products.first.featured_image
  endif

  assign hero_alt = collection.image.alt | default: collection.title

  assign title_words = collection.title | strip | split: ' '
  assign accent_color = collection.metafields.custom.custom_accent_color.value | default: section.settings.accent_color
%}

<section
  class="spuds-collection-hero"
  id="SpudsCollectionHero-{{ section.id }}"
  style="
    --spuds-collection-hero-background: {{ section.settings.background_color }};
    --spuds-collection-hero-text: {{ section.settings.text_color }};
    --spuds-collection-accent: {{ accent_color }};
  "
>
  <div class="spuds-collection-hero__inner">
    <div class="spuds-collection-hero__copy">
      <h1>
        <span class="spuds-collection-hero__title-primary">{{ title_words.first | escape }}</span>
        {% if title_words.size > 1 %}
          <span class="spuds-collection-hero__title-accent-row">
            <span class="spuds-collection-hero__title-accent">
              {% for title_word in title_words offset: 1 %}{% unless forloop.first %} {% endunless %}{{ title_word | escape }}{% endfor %}
            </span>
            <span class="spuds-collection-hero__paw" aria-hidden="true"></span>
          </span>
        {% endif %}
      </h1>

      {% if collection.description != blank %}
        <div class="spuds-collection-hero__description rte">
          {{ collection.description }}
        </div>
        {% unless collection.handle == 'spuds-health' or collection.handle == 'spuds-snacks' %}
          <span class="spuds-collection-hero__underline" aria-hidden="true"></span>
        {% endunless %}
      {% endif %}
    </div>

    <div class="spuds-collection-hero__media{% if hero_image == blank %} spuds-collection-hero__media--placeholder{% endif %}">
      {% if hero_image != blank %}
        {{
          hero_image
          | image_url: width: 2400
          | image_tag:
            widths: '600, 900, 1200, 1600, 2000, 2400',
            sizes: '82vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: hero_alt
        }}
      {% else %}
        {{ 'collection-apparel-1' | placeholder_svg_tag: 'spuds-collection-hero__placeholder' }}
      {% endif %}
    </div>
  </div>

  {% for block in section.blocks %}
    {% if block.settings.collection.id == collection.id and block.settings.collection != blank and block.settings.heading != blank %}
      <div class="spuds-collection-hero__intro" {{ block.shopify_attributes }}>
        <h2>{{ block.settings.heading | escape }}</h2>
      </div>
      {% break %}
    {% endif %}
  {% endfor %}

  {% if collection.id == shop_link.object.id and shop_link.links.size > 0 %}
    <script type="module" src="{{ 'spuds-category-filter.js' | asset_url }}"></script>
    <spuds-category-filter
      hidden
      data-hub-path="{{ collection.url | escape }}"
      data-error="{{ 'spuds_catalog.error' | t | escape }}"
    >
      <div role="group" aria-label="{{ 'spuds_catalog.categories' | t | escape }}">
        <button type="button" data-category="" aria-pressed="true" aria-controls="ResultsList" data-status="{{ 'spuds_catalog.updated' | t: category: shop_link.title | escape }}">{{ 'spuds_catalog.all' | t }}</button>
        {% for category in shop_link.links %}
          {% if category.type == 'collection_link' and category.object != blank %}
            <button type="button" data-category="{{ category.object.handle | escape }}" data-source="{{ category.url | escape }}" data-status="{{ 'spuds_catalog.updated' | t: category: category.object.title | escape }}" aria-pressed="false" aria-controls="ResultsList">{{ category.title | escape }}</button>
          {% endif %}
        {% endfor %}
      </div>
      <span role="status" aria-live="polite" class="visually-hidden"></span>
    </spuds-category-filter>
  {% endif %}
</section>

{% schema %}
{
  "name": "Spuds collection hero",
  "tag": "section",
  "class": "section-spuds-collection-hero",
  "enabled_on": {
    "templates": ["collection"]
  },
  "blocks": [
    {
      "type": "collection_intro",
      "name": "Collection tagline",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "heading", "label": "Tagline" }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Hero background",
      "default": "#faf0e4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Hero text",
      "default": "#071b3d"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Default accent color",
      "info": "Used when this collection does not have a custom.accent_color metafield.",
      "default": "#09a8b5"
    }
  ],
  "presets": [
    {
      "name": "Spuds collection hero"
    }
  ]
}
{% endschema %}
