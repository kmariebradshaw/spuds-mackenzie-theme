{{ 'spuds-homepage.css' | asset_url | stylesheet_tag }}
{% assign story_arrow = section.settings.story_arrow %}
{% assign mission_brush = section.settings.mission_brush %}

<section class="spuds-home" id="SpudsStory-{{ section.id }}">
  <div class="spuds-shell">
    <div class="spuds-story">
      {% if section.settings.background_image != blank %}
        {{ section.settings.background_image | image_url: width: 2400 | image_tag: class: 'spuds-story__background', loading: 'lazy' }}
      {% else %}
        <img class="spuds-story__background" src="{{ 'spuds-history-background.png' | asset_url }}" width="2048" height="719" alt="" loading="lazy">
      {% endif %}

      <div class="spuds-story__grid">
        <div class="spuds-story__era spuds-story__era--old">
          <div class="spuds-story__year">{{ section.settings.old_year }}</div>
          {% if section.settings.old_image != blank %}
            {{ section.settings.old_image | image_url: width: 1000 | image_tag: class: 'spuds-story__polaroid', loading: 'lazy', alt: 'Spuds MacKenzie in 1987' }}
          {% else %}
            <img class="spuds-story__polaroid" src="{{ 'spuds-history-1987.png' | asset_url }}" alt="Spuds MacKenzie in 1987" loading="lazy">
          {% endif %}
        </div>

        <div class="spuds-story__label spuds-story__label--old">
          <h3>{{ section.settings.old_heading }} <span class="spuds-script">{{ section.settings.old_accent }}</span></h3>
          <p>{{ section.settings.old_copy }}</p>
        </div>

        <div class="spuds-story__center">
          {% if story_arrow != blank %}
            {{ story_arrow | image_url: width: 1200 | image_tag: widths: '400,700,900,1200', sizes: '16vw', class: 'spuds-story__arrow', loading: 'lazy', alt: '' }}
          {% else %}
            <img class="spuds-story__arrow" src="{{ 'HP-History-Arrow.webp' | asset_url }}" width="900" height="384" alt="" loading="lazy">
          {% endif %}
          <div class="spuds-story__mission">
            {% if mission_brush != blank %}
              {{ mission_brush | image_url: width: 1000 | image_tag: widths: '400,700,1000', sizes: '21vw', class: 'spuds-story__mission-brush', loading: 'lazy', alt: '' }}
            {% else %}
              <img class="spuds-story__mission-brush" src="{{ 'spuds-history-mission-brush.svg' | asset_url }}" width="447" height="116" alt="" loading="lazy">
            {% endif %}
            <div class="spuds-story__mission-copy">
              {{ section.settings.mission_top }}
              <span>{{ section.settings.mission_bottom }}</span>
            </div>
          </div>
        </div>

        <div class="spuds-story__era spuds-story__era--today">
          <div class="spuds-story__year">{{ section.settings.today_year }}</div>
          {% if section.settings.today_image != blank %}
            {{ section.settings.today_image | image_url: width: 1100 | image_tag: class: 'spuds-story__polaroid', loading: 'lazy', alt: 'Spuds MacKenzie today' }}
          {% else %}
            <img class="spuds-story__polaroid" src="{{ 'spuds-history-today.png' | asset_url }}" alt="Spuds MacKenzie today" loading="lazy">
          {% endif %}
        </div>

        <div class="spuds-story__label spuds-story__label--today">
          <h3>{{ section.settings.today_heading }} <span class="spuds-script">{{ section.settings.today_accent }}</span></h3>
          <p>{{ section.settings.today_copy }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Spuds 1987 and today",
  "tag":"section",
  "class":"section-spuds-story",
  "settings":[
    {"type":"image_picker","id":"background_image","label":"History background"},
    {"type":"header","content":"1987 side"},
    {"type":"image_picker","id":"old_image","label":"Complete 1987 Polaroid graphic"},
    {"type":"text","id":"old_year","label":"Year","default":"1987"},
    {"type":"text","id":"old_heading","label":"Heading","default":"Advertising"},
    {"type":"text","id":"old_accent","label":"Script word","default":"Icon"},
    {"type":"textarea","id":"old_copy","label":"Copy","default":"Spuds MacKenzie became one of the most recognizable dogs in America."},
    {"type":"header","content":"Today side"},
    {"type":"image_picker","id":"today_image","label":"Complete Today Polaroid graphic"},
    {"type":"text","id":"today_year","label":"Label","default":"Today"},
    {"type":"text","id":"today_heading","label":"Heading","default":"Pet"},
    {"type":"text","id":"today_accent","label":"Script word","default":"Legend"},
    {"type":"textarea","id":"today_copy","label":"Copy","default":"That legendary personality inspires a new generation of treats, wellness products, and dogs who know how to have a good time."},
    {"type":"header","content":"Center mission"},
    {"type":"image_picker","id":"story_arrow","label":"Arrow graphic"},
    {"type":"image_picker","id":"mission_brush","label":"Mission brush graphic"},
    {"type":"text","id":"mission_top","label":"Mission line 1","default":"Same legendary spirit."},
    {"type":"text","id":"mission_bottom","label":"Mission line 2","default":"New mission."}
  ],
  "presets":[{"name":"Spuds 1987 and today"}]
}
{% endschema %}
