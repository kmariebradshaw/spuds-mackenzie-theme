{{ 'spuds-about.css' | asset_url | stylesheet_tag }}
{% assign shop_link = section.settings.button_link | default: routes.all_products_collection_url %}
<div class="spuds-about" id="SpudsAbout-{{ section.id }}">
  <div class="spuds-about__hero">
    {% render 'spuds-shape', shape: 'graphic-3', class: 'spuds-about__triangles' %}
    <div class="spuds-about__hero-copy">
      <p class="spuds-about__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ section.settings.heading | escape }}</h1>
      <p class="spuds-about__script">{{ section.settings.accent | escape }}</p>
      <div class="spuds-about__intro">{{ section.settings.intro }}</div>
    </div>
    <div class="spuds-about__portrait">
      {% if section.settings.hero_image != blank %}
        {{ section.settings.hero_image | image_url: width: 1400 | image_tag: widths: '400, 700, 1000, 1400', sizes: '(max-width: 749px) 34vw, 20vw', loading: 'eager', fetchpriority: 'high', class: 'spuds-about__photo' }}
      {% else %}
        <img class="spuds-about__photo" src="{{ 'spuds-polaroid-today.png' | asset_url }}" width="611" height="816" alt="Spuds MacKenzie dressed for the party in sunglasses and a bow tie" fetchpriority="high">
      {% endif %}
      {% render 'spuds-shape', shape: 'graphic-1', class: 'spuds-about__zigzag' %}
      {% render 'spuds-shape', shape: 'paw', class: 'spuds-about__paw' %}
    </div>
  </div>
  <div class="spuds-about__team">
    <div class="spuds-about__stat">
      <span class="spuds-about__number">{{ section.settings.experience_number | escape }}</span>
      <p>{{ section.settings.experience_label | escape }}</p>
      {% render 'spuds-shape', shape: 'graphic-4', class: 'spuds-about__stat-shape' %}
    </div>
    <div class="spuds-about__team-copy">
      <h2>{{ section.settings.team_heading | escape }}</h2>
      <div class="spuds-about__copy">{{ section.settings.team_copy }}</div>
      <div class="spuds-about__charity">
        <h3>{{ section.settings.charity_heading | escape }}</h3>
        <div class="spuds-about__copy">{{ section.settings.charity_copy }}</div>
      </div>
    </div>
  </div>
  <div class="spuds-about__values">
    <h2>{{ section.settings.values_heading | escape }}</h2>
    <div class="spuds-about__values-intro">{{ section.settings.values_copy }}</div>
    {% if section.blocks.size > 0 %}
      <div class="spuds-about__cards">
        {% for block in section.blocks %}
          <div class="spuds-about__card" {{ block.shopify_attributes }}>
            <span class="spuds-about__card-number" aria-hidden="true">0{{ forloop.index }}</span>
            <h3>{{ block.settings.heading | escape }}</h3>
            <div>{{ block.settings.copy }}</div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
  <div class="spuds-about__closing">
    {% render 'spuds-shape', shape: 'graphic-2', class: 'spuds-about__closing-shape' %}
    <h2>{{ section.settings.closing_heading | escape }}</h2>
    <div class="spuds-about__closing-copy">{{ section.settings.chapter_copy }}{{ section.settings.closing_copy }}</div>
    <p class="spuds-about__script">{{ section.settings.closing_accent | escape }}</p>
    {% if section.settings.button_label != blank %}
      <a class="spuds-about__button" href="{{ shop_link }}">
        {{ section.settings.button_label | escape }}
        <img src="{{ 'spuds-cta-arrow.svg' | asset_url }}" width="210" height="72" alt="" aria-hidden="true" loading="lazy">
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Spuds About us",
  "tag": "section",
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Intro label",
      "default": "The Spuds story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "The original party animal."
    },
    {
      "type": "text",
      "id": "accent",
      "label": "Hero accent",
      "default": "All dogs invited."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Legendary personality. Lifelong pet people. A new chapter dedicated to dogs.</p>"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "Uses the Spuds Today Polaroid when left empty."
    },
    {
      "type": "richtext",
      "id": "chapter_copy",
      "label": "Story copy",
      "default": "<p>An iconic dog. A new purpose. Under new ownership, Spuds is bringing his legendary personality to treats, wellness products, and everyday essentials, all focused on pets.</p>"
    },
    {
      "type": "text",
      "id": "experience_number",
      "label": "Experience number",
      "default": "45"
    },
    {
      "type": "text",
      "id": "experience_label",
      "label": "Experience label",
      "default": "Years of combined pet-industry experience"
    },
    {
      "type": "text",
      "id": "team_heading",
      "label": "Team heading",
      "default": "Experience that gives back."
    },
    {
      "type": "richtext",
      "id": "team_copy",
      "label": "Team copy",
      "default": "<p>Our founders bring <strong>45 years of combined experience exclusively in the pet industry</strong>, creating products for the animals we love.</p>"
    },
    {
      "type": "text",
      "id": "charity_heading",
      "label": "Giving back heading",
      "default": "Giving back is part of who we are."
    },
    {
      "type": "richtext",
      "id": "charity_copy",
      "label": "Giving back copy",
      "default": "<p>Through multiple charities run by our founders, we continue to support the pet community that means so much to us.</p>"
    },
    {
      "type": "text",
      "id": "values_heading",
      "label": "Products heading",
      "default": "Simple ingredients. Thoughtfully made."
    },
    {
      "type": "richtext",
      "id": "values_copy",
      "label": "Products introduction",
      "default": "<p>We believe great pet products should be easy to understand and something you feel good about giving your pet.</p>"
    },
    {
      "type": "text",
      "id": "closing_heading",
      "label": "Closing heading",
      "default": "Same spirit. New mission."
    },
    {
      "type": "richtext",
      "id": "closing_copy",
      "label": "Closing copy",
      "default": "<p>Healthy can still be fun. Let’s get the party started!</p>"
    },
    {
      "type": "text",
      "id": "closing_accent",
      "label": "Closing accent",
      "default": "All dogs invited."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Spuds"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Defaults to all products."
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Product pillar",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Thoughtfully made"
        },
        {
          "type": "richtext",
          "id": "copy",
          "label": "Copy",
          "default": "<p>Products for the dogs we love.</p>"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Spuds About us"
    }
  ]
}
{% endschema %}
